{
  "name": "nerds",
  "version": "0.2.0",
  "description": "Offline expedition research and geographic planning",
  "author": "4nR TeK Inc.",
  "private": true,
  "main": "src/main.cjs",
  "scripts": {
    "setup:desktop": "install-electron",
    "start": "electron .",
    "test": "node --test test/*.test.cjs",
    "test:desktop": "node test/desktop.cjs",
    "package": "electron-builder --win msi --x64",
    "package:dir": "electron-builder --win --dir --x64"
  },
  "dependencies": {
    "cesium": "1.146.0",
    "exifr": "7.1.3"
  },
  "devDependencies": {
    "electron": "44.7.1",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "org.fairewindandsong.nerds",
    "productName": "NERDS",
    "copyright": "© 2026 4nR TeK Inc. All rights reserved. Created by Clark Graff.",
    "directories": {
      "output": "dist"
    },
    "electronDist": "node_modules/electron/dist",
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json",
      "node_modules/exifr/**/*",
      "node_modules/cesium/Build/Cesium/**/*",
      "node_modules/cesium/package.json",
      "node_modules/cesium/LICENSE.md",
      "node_modules/cesium/ThirdParty.extra.json",
      "node_modules/cesium/ThirdParty.json"
    ],
    "win": {
      "target": "msi",
      "icon": "assets/nerds.ico",
      "signExecutable": false
    },
    "msi": {
      "oneClick": false,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "NERDS-${version}-${arch}.${ext}"
    },
    "npmRebuild": false,
    "extraFiles": [
      {
        "from": "THIRD-PARTY-NOTICES.txt",
        "to": "THIRD-PARTY-NOTICES.txt"
      }
    ],
    "msiProjectCreated": "scripts/msi-branding.cjs"
  }
}
