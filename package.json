{
  "name": "nerds",
  "version": "1.0.0",
  "description": "Offline expedition research and geographic planning",
  "author": "4nR TeK Inc.",
  "private": true,
  "main": "src/main.cjs",
  "scripts": {
    "setup:desktop": "install-electron",
    "start": "electron .",
    "test": "node --test test/*.test.cjs",
    "test:desktop": "node test/desktop.cjs",
    "package": "electron-builder --win msi --x64",
    "package:dir": "electron-builder --win --dir --x64",
    "prepare:data": "node scripts/restore-gazetteer.cjs",
    "prepackage": "npm run prepare:data"
  },
  "dependencies": {
    "@mapbox/vector-tile": "3.0.0",
    "cesium": "1.146.0",
    "exifr": "7.1.3",
    "geographiclib-geodesic": "2.2.0",
    "pbf": "5.1.2",
    "pngjs": "7.0.0"
  },
  "devDependencies": {
    "electron": "44.7.1",
    "electron-builder": "26.15.3",
    "playwright-core": "^1.65.0"
  },
  "build": {
    "appId": "com.4nr.nerds.devtest041",
    "productName": "NERDS Beta",
    "copyright": "Copyright (c) 2026 4nR TeK Inc. Created by Clark Graff.",
    "directories": {
      "output": "dist"
    },
    "electronDist": "node_modules/electron/dist",
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json",
      "node_modules/exifr/**/*",
      "node_modules/cesium/Build/Cesium/**/*",
      "node_modules/cesium/package.json",
      "node_modules/cesium/LICENSE.md",
      "node_modules/cesium/ThirdParty.extra.json",
      "node_modules/cesium/ThirdParty.json",
      "!assets/geonames.sqlite*",
      "node_modules/geographiclib-geodesic/**/*",
      "!assets/discovery/*.sqlite*"
    ],
    "win": {
      "target": "msi",
      "icon": "assets/nerds.ico",
      "signExecutable": false
    },
    "msi": {
      "oneClick": false,
      "perMachine": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "NERDS-${version}-${arch}.${ext}",
      "upgradeCode": "9156D92F-9DA5-530D-9BCD-D9DDAD09009B"
    },
    "npmRebuild": false,
    "extraFiles": [
      {
        "from": "THIRD-PARTY-NOTICES.txt",
        "to": "THIRD-PARTY-NOTICES.txt"
      }
    ],
    "msiProjectCreated": "scripts/msi-branding.cjs",
    "extraResources": [
      {
        "from": "assets/geonames.sqlite",
        "to": "data/places.sqlite"
      },
      {
        "from": "work/preparation-runtime/nerds-geography",
        "to": "nerds-geography"
      }
    ]
  }
}
